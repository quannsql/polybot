# Runtime only. Keep account secrets in OCI Vault or /opt/polybot/secrets/account.env.
POLYMARKET_MODE=live
POLYMARKET_DRY_RUN=0
POLYMARKET_LIVE_CONFIRM=I_UNDERSTAND_TWAP_20_USD_LIVE_TEST
POLYMARKET_ACCOUNT_ELIGIBILITY_CONFIRMED=1
OCI_POLYBOT_USE_INSTANCE_METADATA=1

POLYMARKET_EXECUTION_STRATEGY=twap60_spot_1400_v1
POLYMARKET_DECISION_DELAY_SECONDS=840
POLYMARKET_MAX_ENTRY_DELAY_SECONDS=845
POLYMARKET_TWAP_MIN_LEAD_BPS=5
POLYMARKET_MIN_ENTRY_PRICE=0.85
POLYMARKET_REFERENCE_MAX_AGE_SECONDS=75
POLYMARKET_REFERENCE_PRICE_PADDING=0.01
POLYMARKET_LIVE_FIXED_STAKE_USD=20
POLYMARKET_MAX_STAKE_USD=20
POLYMARKET_BANKROLL_USD=50
POLYMARKET_LIVE_MAX_PRICE=0.99
POLYMARKET_MIN_WINNING_PNL=0.05
POLYMARKET_DEPTH_FRACTION=0.5
POLYMARKET_LIVE_QUOTE_MAX_AGE_MS=1500
# Lifetime POST/intents in this persistent journal; restart does not reset it.
POLYMARKET_LIVE_MAX_ORDERS=5
POLYMARKET_DAILY_LOSS_STOP=1
POLYMARKET_AUTO_REDEEM=1

POLYMARKET_STATE_PATH=/data/twap_state.sqlite3
POLYMARKET_DECISION_LOG=/data/twap_decisions.jsonl
POLYMARKET_ORACLE_LOG=/data/twap_oracle.jsonl
POLYMARKET_LEGACY_STATE_PATH=/data/live_state.json
