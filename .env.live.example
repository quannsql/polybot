# Copy to a file outside Git (for example /opt/polybot/secrets/live.env), chmod 600.
# Do not paste the completed file into chat or commit it.
POLYMARKET_MODE=live
POLYMARKET_DRY_RUN=0
POLYMARKET_LIVE_CONFIRM=I_UNDERSTAND_ONE_30_USD_ORDER_CAN_LOSE_ALL
POLYMARKET_ACCOUNT_ELIGIBILITY_CONFIRMED=1

# Either set these four locally, or omit all four and set OCI_POLYBOT_SECRET_OCID.
POLYMARKET_SIGNER_PRIVATE_KEY=REPLACE_LOCALLY
POLYMARKET_WALLET_ADDRESS=REPLACE_LOCALLY
POLYMARKET_RELAYER_API_KEY=REPLACE_LOCALLY
POLYMARKET_RELAYER_API_KEY_ADDRESS=REPLACE_LOCALLY
# OCI_POLYBOT_SECRET_OCID=ocid1.vaultsecret...
POLYMARKET_EXPECTED_WALLET_TYPE=REPLACE_WITH_DEPOSIT_WALLET_OR_POLY_PROXY

POLYMARKET_DECISION_DELAY_SECONDS=630
POLYMARKET_MAX_ENTRY_DELAY_SECONDS=690
POLYMARKET_POLL_SECONDS=1
POLYMARKET_LIVE_QUOTE_MAX_AGE_MS=1500
POLYMARKET_MARKET_EVENT_DEBOUNCE_MS=100
POLYMARKET_SIGNAL_POLICY=boundary
POLYMARKET_MIN_ENTRY_PRICE=0.85
POLYMARKET_MIN_EDGE=0.03
POLYMARKET_MAX_SPREAD=0.03
POLYMARKET_LIVE_FIXED_STAKE_USD=30
POLYMARKET_MAX_STAKE_USD=30
POLYMARKET_BANKROLL_USD=30
POLYMARKET_LIVE_MAX_ORDERS=1
POLYMARKET_LIVE_MAX_PRICE=0.97
POLYMARKET_LIVE_PRICE_SLIPPAGE=0.01

# Live orders remain blocked unless this file exists and contains approved=true.
POLYMARKET_CALIBRATION_PATH=/data/calibration.json
POLYMARKET_STATE_PATH=/data/live_state.json
POLYMARKET_DECISION_LOG=/data/live_decisions.jsonl
