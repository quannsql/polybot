FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-paper.txt ./
RUN pip install --no-cache-dir -r requirements-paper.txt
COPY polymarket_bot ./polymarket_bot
COPY preflight_trial.py trial_30usd.json ./
# Deliberately one-shot, read-only, no trading process and no secrets required.
CMD ["python", "-B", "preflight_trial.py", "--output", "/app/trial_preflight.json"]
