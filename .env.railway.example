# Paste non-secret settings into Railway Variables (Raw Editor).
# First deploy: probe uses no wallet credentials and sends no orders.
POLYMARKET_RAILWAY_ACTION=probe
POLYMARKET_MODE=paper
POLYMARKET_DRY_RUN=1
OCI_POLYBOT_USE_INSTANCE_METADATA=0
POLYMARKET_EXECUTION_STRATEGY=twap60_spot_1400_v1
POLYMARKET_LIVE_FIXED_STAKE_USD=20
POLYMARKET_MAX_STAKE_USD=20
POLYMARKET_BANKROLL_USD=50
POLYMARKET_LIVE_MAX_ORDERS=5
POLYMARKET_DAILY_LOSS_STOP=1
POLYMARKET_AUTO_REDEEM=1
# Add the four real account values ONLY in Railway Variables, never in Git.
# POLYMARKET_SIGNER_PRIVATE_KEY
# POLYMARKET_WALLET_ADDRESS
# POLYMARKET_RELAYER_API_KEY
# POLYMARKET_RELAYER_API_KEY_ADDRESS
# Do not set RAILWAY_VOLUME_MOUNT_PATH yourself: attach a volume at /data.
# Live activation (after check, migration and account eligibility review):
# POLYMARKET_RAILWAY_ACTION=run
# POLYMARKET_MODE=live
# POLYMARKET_DRY_RUN=0
# POLYMARKET_ACCOUNT_ELIGIBILITY_CONFIRMED=1
# POLYMARKET_LIVE_CONFIRM=I_UNDERSTAND_TWAP_20_USD_LIVE_TEST
