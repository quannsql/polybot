# Authenticated Chainlink observation only; paper mode does not sign/post orders.
POLYMARKET_MODE=paper
POLYMARKET_DRY_RUN=1
POLYMARKET_EXECUTION_STRATEGY=twap60_spot_1400_v1
POLYMARKET_DECISION_DELAY_SECONDS=840
POLYMARKET_MAX_ENTRY_DELAY_SECONDS=845
POLYMARKET_TWAP_MIN_LEAD_BPS=5
POLYMARKET_LIVE_FIXED_STAKE_USD=20
POLYMARKET_MAX_STAKE_USD=20
POLYMARKET_BANKROLL_USD=50
POLYMARKET_LIVE_MAX_PRICE=0.99
POLYMARKET_STATE_PATH=logs/twap_paper.sqlite3
POLYMARKET_DECISION_LOG=logs/twap_paper_decisions.jsonl
POLYMARKET_ORACLE_LOG=logs/twap_paper_oracle.jsonl
# Fill these locally only, or use the existing Oracle Vault configuration.
POLYMARKET_SIGNER_PRIVATE_KEY=REPLACE_LOCALLY
POLYMARKET_WALLET_ADDRESS=REPLACE_LOCALLY
POLYMARKET_RELAYER_API_KEY=REPLACE_LOCALLY
POLYMARKET_RELAYER_API_KEY_ADDRESS=REPLACE_LOCALLY
