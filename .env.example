# Safe defaults: no private key, no order signing, paper signals only.
POLYMARKET_MODE=paper
POLYMARKET_DRY_RUN=1
POLYMARKET_SYMBOL=BTCUSDT
POLYMARKET_DATA_SOURCE=binance
POLYMARKET_POLL_SECONDS=5
POLYMARKET_DECISION_DELAY_SECONDS=630
POLYMARKET_MAX_ENTRY_DELAY_SECONDS=690
POLYMARKET_SIGNAL_POLICY=boundary
POLYMARKET_ROUTER_ENABLED=1
POLYMARKET_AUX_ENABLED=1
POLYMARKET_HISTORY_5M_BARS=240

# This matches Bot 1's causal router and 15m auxiliary lane.
POLYMARKET_ROUTER_SMA_DAYS=25
POLYMARKET_ROUTER_SHORT_DEPTH_PCT=1.5
POLYMARKET_SHORT_LANE_RUN_BPS=60
POLYMARKET_SESSION_START_UTC=8
POLYMARKET_SESSION_END_UTC=22

# Crypto taker fee documented by Polymarket.  Makers are fee-free.
POLYMARKET_TAKER_FEE_RATE=0.07
POLYMARKET_MIN_EDGE=0.03
POLYMARKET_MAX_SPREAD=0.03
POLYMARKET_BANKROLL_USD=100
POLYMARKET_MIN_ENTRY_PRICE=0.85
POLYMARKET_MAX_STAKE_USD=30
POLYMARKET_KELLY_FRACTION=0.10

# A missing/unapproved calibration blocks all paper/live orders.
POLYMARKET_CALIBRATION_PATH=calibration.json
POLYMARKET_STATE_PATH=logs/paper_state.json
POLYMARKET_DECISION_LOG=logs/decisions.jsonl

# Live remains locked unless every independent guard is explicitly set.
# Never commit this file or paste any secret into chat.
# POLYMARKET_MODE=live
# POLYMARKET_DRY_RUN=0
# POLYMARKET_LIVE_CONFIRM=I_UNDERSTAND_ONE_30_USD_ORDER_CAN_LOSE_ALL
# POLYMARKET_ACCOUNT_ELIGIBILITY_CONFIRMED=1
# POLYMARKET_LIVE_FIXED_STAKE_USD=30
# POLYMARKET_LIVE_MAX_ORDERS=1
# POLYMARKET_LIVE_MAX_PRICE=0.97
# POLYMARKET_LIVE_PRICE_SLIPPAGE=0.01
# POLYMARKET_EXPECTED_WALLET_TYPE=DEPOSIT_WALLET
# POLYMARKET_SIGNER_PRIVATE_KEY=0x...
# POLYMARKET_WALLET_ADDRESS=0x...
# POLYMARKET_RELAYER_API_KEY=...
# POLYMARKET_RELAYER_API_KEY_ADDRESS=...
# POLYMARKET_STATE_PATH=/data/live_state.json
# POLYMARKET_DECISION_LOG=/data/live_decisions.jsonl
